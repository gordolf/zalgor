void blink(void) {
  pixels.setPixelColor(0, pixels.Color(0, random(25, 200), 0));
  pixels.show();

  display.clearDisplay();
  display.drawBitmap(0, 0, image_LB1_bits, 135, 64, 1);
  display.display();

  delay(50);

  pixels.setPixelColor(0, pixels.Color(0, random(25, 200), 0));
  pixels.show();

  display.clearDisplay();
  display.drawBitmap(0, 0, image_LB2_bits, 135, 64, 1);
  display.display();
  delay(50);

  pixels.setPixelColor(0, pixels.Color(0, random(50, 200), 0));
  pixels.show();

  display.clearDisplay();
  display.drawBitmap(0, 0, image_LB3_bits, 135, 64, 1);
  display.display();
  delay(50);

  pixels.setPixelColor(0, pixels.Color(0, random(25, 200), 0));
  pixels.show();
}

void strobe(void) {

  for (int i = 0; i <= 20; i++) {

    pixels.setPixelColor(0, pixels.Color(0, 0, 0));
    pixels.show();
    delay(25);
    pixels.setPixelColor(0, pixels.Color(200, 255, 255));
    pixels.show();
    delay(25);
  }

  pixels.setPixelColor(0, pixels.Color(0, random(50, 200), 0));
  pixels.show();
}

void fortune(void) {

  buttonState = false;

  for (int i = 0; i <= 3; i++) {

    pixels.setPixelColor(0, pixels.Color(200, 255, 255));
    pixels.show();

    for (int16_t i = 0; i < display.height() / 2 - 2; i += 2) {
      // The INVERSE color is used so round-rects alternate white/black
      display.fillRoundRect(i, i, display.width() - 2 * i, display.height() - 2 * i,
                            display.height() / 4, SSD1306_INVERSE);
      display.display();
      delay(1);
    }
  }

  int randofortune = random(1, 22);
  Serial.print(randofortune);
