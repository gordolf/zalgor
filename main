void setup() {
  Serial.begin(9600);

  // SSD1306_SWITCHCAPVCC = generate display voltage from 3.3V internally
  if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    Serial.println(F("SSD1306 allocation failed"));
    for (;;)
      ;  // Don't proceed, loop forever
  }

  pinMode(relay, OUTPUT);
  pinMode(relay2, OUTPUT);
  pinMode(buttonPin, INPUT);

  pixels.begin();

  // Clear the buffer
  display.clearDisplay();

  pixels.setPixelColor(0, pixels.Color(150, 0, 0));
  pixels.show();
  delay(250);

  digitalWrite(relay, LOW);
  delay(250);
  digitalWrite(relay, HIGH);

  digitalWrite(relay2, LOW);
  delay(250);
  digitalWrite(relay2, HIGH);
}

void loop() {

  //buttonState = digitalRead(buttonPin);

  attachInterrupt(digitalPinToInterrupt(buttonPin), buttonbool, RISING);

  if (buttonState == true) {
    Serial.print("BUTTON HIGH");
    digitalWrite(relay, LOW);
    display.invertDisplay(true);
    strobe();
    display.invertDisplay(false);
    fortune();
  }

  // idle animation
  int rando = random(1, 41);
  Serial.println(rando);

  if (rando <= 20) {
    staticeyes();
  }
  if (rando >= 21 && rando <= 25) {
    blink();
  }
  if (rando >= 26 && rando <= 30) {
    lookleft();
  }
  if (rando >= 31 && rando <= 35) {
    lookright();
  }
  if (rando >= 36 && rando <= 39) {
    lookrightshifty();
  }
  if (rando == 40) {
    lookcrosseyed();
  }
}

void buttonbool() {

  buttonState = true;

}

void lookright(void) {

  display.clearDisplay();
  display.drawBitmap(0, 0, image_L_LR1_bits, 135, 64, 1);
  display.display();
  delay(100);

  display.clearDisplay();
  display.drawBitmap(0, 0, image_L_LR2_bits, 135, 64, 1);
  display.display();
  delay(400);

  display.clearDisplay();
  display.drawBitmap(0, 0, image_L_LR1_bits, 135, 64, 1);
  display.display();
  delay(100);
}

void lookcrosseyed(void) {

  display.clearDisplay();
  display.drawBitmap(0, 0, image_L_LR1_bits, 135, 64, 1);
  display.display();
  delay(400);

  display.clearDisplay();
  display.drawBitmap(0, 0, image_L_LR2_bits, 135, 64, 1);
  display.display();
  delay(200);

  display.clearDisplay();
  display.drawBitmap(0, 0, image_L_LR1_bits, 135, 64, 1);
  display.display();
  delay(400);
}

